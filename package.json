{
  "name": "tracegate-ci",
  "version": "0.9.1",
  "description": "Test-impact selection for Vitest and Jest from observed per-file footprints, and a local broker that gives every gate, daemon, measurement and AI agent on a machine one fair queue.",
  "license": "Apache-2.0",
  "author": "David Tufts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidscotttufts/tracegate-ci.git"
  },
  "homepage": "https://github.com/davidscotttufts/tracegate-ci#readme",
  "bugs": {
    "url": "https://github.com/davidscotttufts/tracegate-ci/issues"
  },
  "keywords": [
    "vitest",
    "test-impact-analysis",
    "test-selection",
    "local-ci",
    "merge-queue",
    "claude-code",
    "mcp",
    "ai-agents",
    "flaky-tests"
  ],
  "mcpName": "io.github.davidscotttufts/tracegate-ci",
  "type": "module",
  "bin": {
    "tracegate": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./vitest-setup": "./src/vitest-setup.mjs",
    "./jest-environment": "./src/jest-environment.mjs",
    "./recorder": "./src/recorder.mjs",
    "./package.json": "./package.json",
    "./broker": "./src/broker/core.mjs",
    "./sequencer": "./src/vitest-sequencer.mjs",
    "./reporter": "./src/vitest-reporter.mjs"
  },
  "files": [
    "src/",
    "agents/",
    "skills/",
    "hooks/",
    ".claude-plugin/",
    "server.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/broker.mjs && node test/adaptive.mjs && node test/red.mjs && node test/deps.mjs && node test/conductor.mjs && node test/jobserver.mjs && node test/onboarding.mjs && node test/evidence.mjs && node test/train.mjs && node test/silence.mjs && node test/attest.mjs && node test/jest.mjs",
    "test:sabotage": "node test/sabotage.mjs",
    "test:e2e": "bash examples/e2e.sh",
    "test:e2e-jest": "SAMPLE=sample-repo-jest STRICT_SEAM=1 bash examples/e2e.sh",
    "test:broker": "node test/broker.mjs",
    "test:adaptive": "node test/adaptive.mjs",
    "test:red": "node test/red.mjs",
    "test:deps": "node test/deps.mjs",
    "test:conductor": "node test/conductor.mjs",
    "test:jobserver": "node test/jobserver.mjs",
    "test:vitest-matrix": "bash examples/vitest-matrix.sh",
    "test:onboarding": "node test/onboarding.mjs",
    "test:evidence": "node test/evidence.mjs",
    "test:train": "node test/train.mjs",
    "test:silence": "node test/silence.mjs",
    "test:attest": "node test/attest.mjs",
    "test:jest": "node test/jest.mjs",
    "test:compare": "bash examples/compare-vitest.sh"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7",
    "vitest": ">=4.1.0 <6",
    "jest": ">=30.0.0 <31"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
